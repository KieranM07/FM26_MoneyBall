@code {
    private List<WingFullBack> wingfullbacks = new();
    private List<WingFullBack> topWingFullBacks = new();
    private List<WingFullBack> allWingFullBacks = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool allPlayers = false;
    private bool expanded = false;

    protected override void OnInitialized()
    {
        wingfullbacks = WFBState.WingFullBacks;
      
        if (wingfullbacks.Any())
        {
            try
            {
                WFBPredictor.PredictWingFullBacks(wingfullbacks);
                allWingFullBacks = wingfullbacks.Where(wfb => wfb.PredictedValue.HasValue && wfb.TransferValue.HasValue)
                .OrderByDescending(wfb =>
                    (wfb.PredictedValue!.Value - wfb.TransferValue!.Value))
                .Take(100)
                .ToList();

                topWingFullBacks = wingfullbacks
                .Where(wfb => wfb.PredictedValue.HasValue && wfb.TransferValue.HasValue)
                .OrderByDescending(wfb =>
                    (wfb.PredictedValue!.Value - wfb.TransferValue!.Value))
                .Take(25)
                .ToList();
                hasPredictions = topWingFullBacks.Any();

            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            
        }
    }

    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
    }

    private void ToggleView()
    {
        expanded = !expanded;
    }
    
}
