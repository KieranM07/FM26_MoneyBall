                        <th>Age</th>
                        <th>Current Club</th>
                        <th>Nationality</th>
                        <th>Minutes Since Last Goal</th>
                        <th>Goals</th>
                        <th>Off</th>
                        <th>Shots on Target</th>
                        <th>Shot per 90</th>
                        <th>Shots on Target Percentage</th>
                        <th>Goals From Outside The Box</th>
                        <th>NP-xG per 90</th>
                        <th>Dribbles per 90</th>
                        <th>Conversion Percentage</th>
                        <th>xG</th>
                        <th>Pressures Completed per 90</th>
                        <th>Shots on Target per 90</th>
                        <th>Shots</th>
                        <th>xG per Shot</th>
                        <th>Possession Lost per 90</th>
