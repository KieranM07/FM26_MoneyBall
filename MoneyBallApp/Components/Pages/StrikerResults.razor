                            <td>@striker.FoulsAgainst</td>
                            <td>@striker.Assists</td>
                            <td>@striker.Goalsper90minutes</td>
                            <td>@striker.MinsGm</td>

                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
}
</div>

@code {
    private List<Striker> strikers = new();
    private List<Striker> topStrikers = new();
    private List<Striker> allStrikers = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool allPlayers = false;
    private bool expanded = false;

    protected override void OnInitialized()
    {
        strikers = STState.Strikers;
      
        if (strikers.Any())
        {
            try
            {
                STPredictor.PredictStrikers(strikers);
                allStrikers = strikers.Where(st => st.PredictedValue.HasValue && st.TransferValue.HasValue)
                .OrderByDescending(st =>
                    (st.PredictedValue!.Value - st.TransferValue!.Value))
                .Take(100)
                .ToList();

                topStrikers = strikers
                .Where(st => st.PredictedValue.HasValue && st.TransferValue.HasValue)
                .OrderByDescending(st =>
                    (st.PredictedValue!.Value - st.TransferValue!.Value))
                .Take(25)
                .ToList();
                hasPredictions = topStrikers.Any();

            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            
        }
    }

    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
    }

    private void ToggleView()
    {
        expanded = !expanded;
    }
    
}
