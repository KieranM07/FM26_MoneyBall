@page "/STsPredicted"

@using MoneyBallApp.Components.States
@using MoneyBallApp.Models
@using MoneyBallApp.Services

@rendermode InteractiveServer

@inject STState STState
@inject STPredictorService STPredictor

<PageTitle>Predicted</PageTitle>

<div class="predicted-page">
<h1>Money Ball Valuation App</h1>

@if (!string.IsNullOrEmpty(error))
{
    <p>@error</p>
}
<button class="btn btn-primary" @onclick="TogglePlayers">
    @(allPlayers ? "Show Top 25" : "Show Top 100")
</button>

<button class="btn btn-primary" @onclick="ToggleView">
    @(expanded ? "Show Standard View" : "Show Expanded View")
</button>

@if (!hasPredictions)
{
    <p>No predictions found.</p>
    <p>Ensure Player Type selection is correct and the data is in the correct view for exporting.</p>
}
else
{
    
    if (!allPlayers)
    {
        <h1>Top 25 Strikers by Valuation Difference</h1>
        if (!expanded)
        {
            
          
                <div class="table-container">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Actual</th>
                            <th>Predicted</th>
                            <th>Difference</th>
                            <th>Age</th>
                            <th>Current Club</th>
                            <th>Nationality</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var striker in topStrikers)
                        {
                            <tr>
                                <td>@striker.PlayerName</td>
                                <td>£@striker.TransferValue</td>
                                <td>
                                    @(striker.PredictedValue < 0
                                        ? "Model is not accurately able to predict this value"
                                        : $"£{striker.PredictedValue}")
                                </td>
                                <td>
                                    @(striker.PredictedValue.Value - striker.TransferValue.Value < 0
                                        ? "Player's Market value is higher than prediction"
                                        : $"£{striker.PredictedValue.Value - striker.TransferValue.Value}")
                                </td>
                                <td>@striker.Age</td>
                                <td>@striker.Club</td>
                                <td>@striker.Nation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
