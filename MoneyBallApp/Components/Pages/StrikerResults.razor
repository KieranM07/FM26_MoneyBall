@page "/STsPredicted"

@using MoneyBallApp.Components.States
@using MoneyBallApp.Models
@using MoneyBallApp.Services

@rendermode InteractiveServer

@inject STState STState
@inject STPredictorService STPredictor

<PageTitle>Predicted</PageTitle>

<div class="predicted-page">
<h1>Money Ball Valuation App</h1>

@if (!string.IsNullOrEmpty(error))
{
    <p>@error</p>
}
<button class="btn btn-primary" @onclick="TogglePlayers">
    @(allPlayers ? "Show Top 25" : "Show Top 100")
</button>

<button class="btn btn-primary" @onclick="ToggleView">
    @(expanded ? "Show Standard View" : "Show Expanded View")
</button>

@if (!expanded)
{
    <select @bind="choice" @bind:after="UpdateStrikers">
        <option value="Value Difference">Difference</option>
        <option value="Predicted Value">Predicted Value</option>
        <option value="Actual Value">Actual Value</option>
        <option value="Age">Age</option>
    </select>
}
else if (expanded)
{
    <select @bind="choice" @bind:after="UpdateStrikers">
        <option value="Value Difference">Difference</option>
        <option value="Predicted Value">Predicted Value</option>
        <option value="Actual Value">Actual Value</option>
        <option value="Age">Age</option>
        <option value="Minutes Since Last Goal">Minutes Since Last Goal</option>
        <option value="Goals">Goals</option>
        <option value="Assists">Assists</option>
        <option value="Goals Per 90 minutes">Goals per 90 Minutes</option>
        <option value="Conversion Percentage">Conversion Percentage</option>
        <option value="Goals From Outside The Box">Goals from Outside the Box</option>
        <option value="Offsides">Offsides</option>
        <option value="Shots">Shots</option>
        <option value="Shots Per 90">Shots per 90</option>
        <option value="Shots On Target">Shots on Target</option>
        <option value="Shots On Target Per90">Shots on Target per 90</option>
        <option value="Shots On Target Percentage">Shots on Target Percentage</option>
        <option value="xG Per Shot">xG per Shot</option>
        <option value="xG">Expected Goals (xG)</option>
        <option value="Non Penalty xG">Non-Penalty xG</option>
        <option value="Non Penalty xG Per 90">Non-Penalty xG per 90</option>
        <option value="Clear Cut Chances Created">Clear-Cut Chances Created</option>
        <option value="Chances Created Per 90">Chances Created per 90</option>
        <option value="Assists Per 90">Assists per 90</option>
        <option value="Pass Completion Percentage">Pass Completion Percentage</option>
        <option value="Dribbles Per 90">Dribbles per 90</option>
        <option value="Possession Lost Per 90">Possession Lost per 90</option>
        <option value="Pressures Completed per 90">Pressures per 90</option>
        <option value="Distance Per 90">Distance per 90</option>
        <option value="Fouls Against">Fouls Against</option>
        <option value="Minutes Per Game">Minutes per Game</option>
    </select>
}


@if (!hasPredictions)
{
    <p>No predictions found.</p>
    <p>Ensure Player Type selection is correct and the data is in the correct view for exporting.</p>
}
else
{
    <h1>Top @playercount Strikers by @choice</h1>
    if (!expanded)
    {
            <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Actual</th>
                        <th>Predicted</th>
                        <th>Difference</th>
                        <th>Age</th>
                        <th>Current Club</th>
                        <th>Nationality</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var striker in allStrikers)
                    {
                        <tr>
                            <td>@striker.PlayerName</td>
                            <td>£@striker.TransferValue?.ToString("N0")</td>
                            <td>
                                @(striker.PredictedValue < 0
                                    ? "Model is not accurately able to predict this value"
                                    : $"£{striker.PredictedValue:N0}")
                            </td>
                            <td>
                                @(striker.PredictedValue.Value - striker.TransferValue.Value < 0
                                    ? "Player's Market value is higher than prediction"
                                    : $"£{(striker.PredictedValue.Value - striker.TransferValue.Value):N0}")
                            </td>
                            <td>@striker.Age</td>
                            <td>@striker.Club</td>
                            <td>@striker.Nation</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {    
        <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <!-- Player info -->
                    <th>Player</th>
                    <th>Actual</th>
                    <th>Predicted</th>
                    <th>Difference</th>
                    <th>Age</th>
                    <th>Current Club</th>
                    <th>Nationality</th>
                    <!-- Goals & Finishing -->
                    <th>Goals</th>
                    <th>Assists</th>
                    <th>Goals per 90</th>
                    <th>Minutes since last Goal</th>
                    <th>Conversion %</th>
                    <th>Goals Outside Box</th>
                    <th>Offsides</th>
                    <!-- Shooting -->
                    <th>Shots</th>
                    <th>Shots per 90</th>
                    <th>Shots on Target</th>
                    <th>Shots on Target per 90</th>
                    <th>Shots on Target %</th>
                    <th>xG per Shot</th>
                    <!-- Expected Goals -->
                    <th>xG</th>
                    <th>NPxG</th>
                    <th>NPxG per 90</th>
                    <!-- Creativity -->
                    <th>Chances Created</th>
                    <th>Chances Created per 90</th>
                    <th>Clear-Cut Chances Created</th>
                    <th>Assists per 90</th>
                    <th>Passes Completed %</th>
                    <!-- Dribbling & Possession -->
                    <th>Dribbles per 90</th>
                    <th>Possession Lost per 90</th>
                    <!-- Defensive & Other -->
                    <th>Pressures per 90</th>
                    <th>Distance per 90</th>
                    <th>Fouls Won</th>
                    <th>Minutes Played per Game</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var striker in allStrikers)
                {
                    <tr>
                        <td>@striker.PlayerName</td>
                        <td>£@striker.TransferValue?.ToString("N0")</td>
                        <td>
                            @(striker.PredictedValue < 0
                                ? "Model is not accurately able to predict this value"
                                : $"£{striker.PredictedValue:N0}")
                        </td>
                        <td>
                            @(striker.PredictedValue.Value - striker.TransferValue.Value < 0
                                ? "Player's Market value is higher than prediction"
                                : $"£{(striker.PredictedValue.Value - striker.TransferValue.Value):N0}")
                        </td>
                        <td>@striker.Age</td>
                        <td>@striker.Club</td>
                        <td>@striker.Nation</td>
                        <!-- Goals & Finishing -->
                        <td>@striker.Goals</td>
                        <td>@striker.Assists</td>
                        <td>@striker.Goalsper90minutes</td>
                        <td>@striker.MinutesSinceLastGoal</td>
                        <td>@striker.ConvPercentage</td>
                        <td>@striker.GoalsFromOutsideTheBox</td>
                        <td>@striker.Off</td>
                        <!-- Shooting -->
                        <td>@striker.Shots</td>
                        <td>@striker.Shot90</td>
                        <td>@striker.ShotsOnTarget</td>
                        <td>@striker.ShotsOnTargetper90</td>
                        <td>@striker.ShotsOnTargetPercentage</td>
                        <td>@striker.xGShot</td>
                        <!-- Expected Goals -->
                        <td>@striker.xG</td>
                        <td>@striker.NPxG</td>
                        <td>@striker.NPxG90</td>
                        <!-- Creativity -->
                        <td>@striker.ClearCutChancesCreated</td>
                        <td>@striker.ChancesCreatedper90</td>
                        <td>@striker.ClearCutChancesCreated</td>
                        <td>@striker.Asts90</td>
                        <td>@striker.PassCompletionPercentage</td>
                        <!-- Dribbling & Possession -->
                        <td>@striker.Dribblesper90</td>
                        <td>@striker.PossessionLostper90</td>
                        <!-- Defensive & Other -->
                        <td>@striker.PresC90</td>
                        <td>@striker.Dist90</td>
                        <td>@striker.FoulsAgainst</td>
                        <td>@striker.MinsGm</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}        

</div>

@code {
    private List<Striker> strikers = new();
    private List<Striker> allStrikers = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool expanded = false;
    private string choice = "Value Difference";
    private bool allPlayers = false;
    private int playercount = 25;

    protected override void OnInitialized()
    {
        strikers = STState.Strikers;

        if (strikers.Any())
        {
            try
            {
                UpdateStrikers();
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }

        }
    }
    private void UpdateStrikers()
    {
        playercount = allPlayers ? 100 : 25;

        STPredictor.PredictStrikers(strikers);

        var filteredStrikers = strikers
            .Where(st => st.PredictedValue.HasValue &&
                         st.TransferValue.HasValue);

        allStrikers = (choice switch
        {
            "Predicted Value" => filteredStrikers.OrderByDescending(st => st.PredictedValue!.Value),
            "Actual Value" => filteredStrikers.OrderByDescending(st => st.TransferValue!.Value),
            "Value Difference" => filteredStrikers.OrderByDescending(st => st.PredictedValue!.Value - st.TransferValue!.Value),
            "Age" => filteredStrikers.OrderByDescending(st => st.Age!.Value),
            "Minutes Since Last Goal" => filteredStrikers.OrderByDescending(st => st.MinutesSinceLastGoal!.Value),
            "Goals" => filteredStrikers.OrderByDescending(st => st.Goals!.Value),
            "Assists" => filteredStrikers.OrderByDescending(st => st.Assists!.Value),
            "Goals Per 90 minutes" => filteredStrikers.OrderByDescending(st => st.Goalsper90minutes!.Value),
            "Conv Percentage" => filteredStrikers.OrderByDescending(st => st.ConvPercentage!.Value),
            "Goals From Outside The Box" => filteredStrikers.OrderByDescending(st => st.GoalsFromOutsideTheBox!.Value),
            "Offsides" => filteredStrikers.OrderByDescending(st => st.Off!.Value),
            "Shots" => filteredStrikers.OrderByDescending(st => st.Shots!.Value),
            "Shot 90" => filteredStrikers.OrderByDescending(st => st.Shot90!.Value),
            "Shots On Target" => filteredStrikers.OrderByDescending(st => st.ShotsOnTarget!.Value),
            "Shots On Target per 90" => filteredStrikers.OrderByDescending(st => st.ShotsOnTargetper90!.Value),
            "Shots On Target Percentage" => filteredStrikers.OrderByDescending(st => st.ShotsOnTargetPercentage!.Value),
            "xG Per Shot" => filteredStrikers.OrderByDescending(st => st.xGShot!.Value),
            "xG" => filteredStrikers.OrderByDescending(st => st.xG!.Value),
            "Non Penalty xG" => filteredStrikers.OrderByDescending(st => st.NPxG!.Value),
            "Non Penalty xG Per 90" => filteredStrikers.OrderByDescending(st => st.NPxG90!.Value),
            "Clear Cut Chances Created" => filteredStrikers.OrderByDescending(st => st.ClearCutChancesCreated!.Value),
            "Chances Created Per 90" => filteredStrikers.OrderByDescending(st => st.ChancesCreatedper90!.Value),
            "Assists Per 90" => filteredStrikers.OrderByDescending(st => st.Asts90!.Value),
            "Pass Completion Percentage" => filteredStrikers.OrderByDescending(st => st.PassCompletionPercentage!.Value),
            "Dribbles Per 90" => filteredStrikers.OrderByDescending(st => st.Dribblesper90!.Value),
            "Possession Lost Per 90" => filteredStrikers.OrderByDescending(st => st.PossessionLostper90!.Value),
            "Pressures Completed Per 90" => filteredStrikers.OrderByDescending(st => st.PresC90!.Value),
            "Distance per 90" => filteredStrikers.OrderByDescending(st => st.Dist90!.Value),
            "Fouls Against" => filteredStrikers.OrderByDescending(st => st.FoulsAgainst!.Value),
            "Minutes Per Game" => filteredStrikers.OrderByDescending(st => st.MinsGm!.Value),
            _ => filteredStrikers.OrderByDescending(st => st.PredictedValue!.Value - st.TransferValue!.Value)
        })
        .Take(playercount)
        .ToList();
    }
    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
        playercount = allPlayers ? 100 : 25;
        UpdateStrikers();
    }
    private void ToggleView()
    {
        expanded = !expanded;
        if(expanded == false)
        {
            choice = "Value Difference";
        }
        UpdateStrikers();
    }
    
}
