                            </td>
                            <td>@striker.Age</td>
                            <td>@striker.Club</td>
                            <td>@striker.Nation</td>

                            <td>@striker.MinutesSinceLastGoal</td>
                            <td>@striker.Goals</td>
                            <td>@striker.Off</td>
                            <td>@striker.ShotsOnTarget</td>
                            <td>@striker.Shot90</td>
                            <td>@striker.ShotsOnTargetPercentage</td>
                            <td>@striker.GoalsFromOutsideTheBox</td>
                            <td>@striker.NPxG90</td>
                            <td>@striker.Dribblesper90</td>
                            <td>@striker.ConvPercentage</td>
                            <td>@striker.xG</td>
                            <td>@striker.PresC90</td>
                            <td>@striker.ShotsOnTargetper90</td>
                            <td>@striker.Shots</td>
                            <td>@striker.xGShot</td>
                            <td>@striker.PossessionLostper90</td>
                            <td>@striker.PassCompletionPercentage</td>
                            <td>@striker.ClearCutChancesCreated</td>
                            <td>@striker.ChancesCreatedper90</td>
                            <td>@striker.Asts90</td>
                            <td>@striker.NPxG</td>
                            <td>@striker.Dist90</td>
                            <td>@striker.FoulsAgainst</td>
                            <td>@striker.Assists</td>
                            <td>@striker.Goalsper90minutes</td>
                            <td>@striker.MinsGm</td>

                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
    else
    {
        <h1>Top 100 Strikers by Valuation Difference</h1>
        if (!expanded)
        {
            <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Actual</th>
                        <th>Predicted</th>
                        <th>Difference</th>
                        <th>Age</th>
                        <th>Current Club</th>
                        <th>Nationality</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var striker in allStrikers)
                    {
                        <tr>
                            <td>@striker.PlayerName</td>
                            <td>£@striker.TransferValue</td>
                            <td>
                                @(striker.PredictedValue < 0
