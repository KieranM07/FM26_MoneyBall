                        <th>Predicted</th>
                        <th>Difference</th>
                        <th>Age</th>
                        <th>Current Club</th>
                        <th>Nationality</th>
                        <th>Minutes Since Last Goal</th>
                        <th>Goals</th>
                        <th>Off</th>
                        <th>Shots on Target</th>
                        <th>Shot per 90</th>
                        <th>Shots on Target Percentage</th>
                        <th>Goals From Outside The Box</th>
                        <th>NP-xG per 90</th>
                        <th>Dribbles per 90</th>
                        <th>Conversion Percentage</th>
                        <th>xG</th>
                        <th>Pressures Completed per 90</th>
                        <th>Shots on Target per 90</th>
                        <th>Shots</th>
                        <th>xG per Shot</th>
                        <th>Possession Lost per 90</th>
                        <th>Pass Completion Percentage</th>
                        <th>Clear Cut Chances Created</th>
                        <th>Chances Created per 90</th>
                        <th>Assists per 90</th>
                        <th>NP-xG</th>
                        <th>Distance per 90</th>
                        <th>Fouls Against</th>
                        <th>Assists</th>
                        <th>Goals per 90 Minutes</th>
                        <th>Minutes per Goal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var striker in topStrikers)
                    {
                        <tr>
                            <td>@striker.PlayerName</td>
                            <td>£@striker.TransferValue</td>
                            <td>
