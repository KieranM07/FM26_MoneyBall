@page "/input"
@using Microsoft.AspNetCore.Components.Forms
@using MoneyBallApp.Components.States
@using MoneyBallApp.Models
@using MoneyBallApp.Services
@rendermode InteractiveServer

@inject KeeperParser KParser
@inject CentreBackParser CBParser
@inject WingFullBackParser WFBParser
@inject DefMidParser DMParser
@inject MidParser MParser
@inject WingParser WParser
@inject STParser STParser
@inject KeeperState KeeperState
@inject CBState CBState
@inject WFBState WFBState
@inject DMState DMState
@inject MState MState
@inject WState WState
@inject STState STState


<div class="input-container">
<h3>Upload Players</h3>
@if (string.IsNullOrEmpty(selectedPlayerType))
{
	<label for="playerType">Player type:</label>

	<select id="playerType" @onchange="PlayerTypeChanged">
		<option value="">-- Select type --</option>
		<option value="Keeper">Keeper</option>
		<option value="Centre Back">Centre Back</option>
		<option value="Wing/Full Back">Wing/Full Back</option>
		<option value="Defensive Midfielder">Defensive Midfielder</option>
		<option value="Midfielder">Midfielder</option>
		<option value="Winger">Winger</option>
		<option value="Striker">Striker</option>
	</select>
}
else
{
	<p>
		<strong>Player type:</strong> @selectedPlayerType
	</p>

	<label>Select HTML file:</label>

	<label for="htmlFile" class="html-button">
		Choose file
	</label>

	<InputFile id="htmlFile"
	OnChange="HandleFileSelected"
	accept=".html,.htm"
	style="display: none;" />

	<div>
		@if (!string.IsNullOrEmpty(selectedFileName))
		{
			<span>
				File uploaded successfully
			</span>
		}
	</div>

}

@if (!string.IsNullOrEmpty(error))
{
    <div>
        <p>
            @error
        </p>
    </div>

}

@{
    var resultType = "";

    if (keepers != null && keepers.Any())
        resultType = "keepers";
    else if (centrebacks != null && centrebacks.Any())
        resultType = "centrebacks";
    else if (wingfullbacks != null && wingfullbacks.Any())
        resultType = "wingfullbacks";
    else if (defmids != null && defmids.Any())
        resultType = "defmids";
    else if (mids != null && mids.Any())
        resultType = "mids";
    else if (wingers != null && wingers.Any())
        resultType = "wings";

    else if (strikers != null && strikers.Any())
        resultType = "sts";
   
}

@switch (resultType)
{
    case "keepers":
        <div>
            <a href="/KeepersPredicted" class="file-button">
                Get Results for Keepers
            </a>
        </div>
        break;

    case "centrebacks":
        <div>
            <a href="/CBsPredicted" class="file-button">
                Get Results for CentreBacks
            </a>
        </div>
        break;

    case "wingfullbacks":
        <div>
            <a href="/WFBsPredicted" class="file-button">
                Get Results for Wing/FullBacks
            </a>
        </div>
        break;

    case "defmids":
        <div>
            <a href="/DMsPredicted" class="file-button">
                Get Results for DefMids
            </a>
        </div>
        break;

    case "mids":
        <div>
            <a href="/MsPredicted" class="file-button">
                Get Results for Midfielders
            </a>
        </div>
        break;

    case "wings":
        <div>
            <a href="/WsPredicted" class="file-button">
                Get Results for Wingers
            </a>
        </div>
        break;
    case "sts":
        <div>
            <a href="/STsPredicted" class="file-button">
                Get Results for Strikers
            </a>
        </div>
        break;
}


@if (!string.IsNullOrEmpty(selectedPlayerType))
{
    <div>
        <button @onclick="ResetPlayerType" class="reset-button">Back</button>
    </div>
}
</div>
@code {
    private string? selectedPlayerType;
    private string? selectedFileName;
    private string? error;

    public List<Keeper> keepers = new();
    public List<CentreBack> centrebacks = new();
    public List<WingFullBack> wingfullbacks = new();
    public List<DefMid> defmids = new();
    public List<Mid> mids = new();
    public List<Winger> wingers = new();
    public List<Striker> strikers = new();

    private void PlayerTypeChanged(ChangeEventArgs e) { selectedPlayerType = e.Value?.ToString(); }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(selectedPlayerType))
            return;

        var file = e.File;
        selectedFileName = file.Name;

        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var reader = new StreamReader(stream);

        var html = await reader.ReadToEndAsync();

        // Parse based on the type selected by the user
        switch (selectedPlayerType)
        {
            case "Keeper":
                try
                {
                    keepers = KParser.ParseKeepers(html);
                    KeeperState.Keepers = keepers;
                }
                catch (Exception)
                {
                    error = "Error parsing Keeper file, Ensure that it is in the right format";
                }
                break;

            case "Centre Back":
                try
                {
                    centrebacks = CBParser.ParseCentreBacks(html);
                    CBState.Centrebacks = centrebacks;
                }
                catch (Exception)
                {
                    error = "Error parsing CentreBack file, Ensure that it is in the right format";
                }
                break;

            case "Wing/Full Back":
                try
                {
                    wingfullbacks = WFBParser.ParseWingFullBacks(html);
                    WFBState.WingFullBacks = wingfullbacks;
                }
                catch (Exception)
                {
                    error = "Error parsing wing/fullback file, Ensure that it is in the right format";
                }
                break;

            case "Defensive Midfielder":
                try
                {
                    defmids = DMParser.ParseDefMids(html);
                    DMState.DefMids = defmids;
                }
                catch (Exception)
                {
                    error = "Error parsing DefMid file, Ensure that it is in the right format";
                }
                break;

            case "Midfielder":
                try
                {
                    mids = MParser.ParseMids(html);
                    MState.Mids = mids;
                }
                catch (Exception)
                {
                    error = "Error parsing Midfielder file, Ensure that it is in the right format";
                }
                break;

            case "Winger":
                try
                {
                    wingers = WParser.ParseWingers(html);
                    WState.Wingers = wingers;
                }
                catch (Exception)
                {
                    error = "Error parsing Winger file, Ensure that it is in the right format";
                }
                break;

            case "Striker":
                try
                {
                    strikers = STParser.ParseStrikers(html);
                    STState.Strikers = strikers;
                }
                catch (Exception)
                {
                    error = "Error parsing Striker file, Ensure that it is in the right format";
                }
                break;
        }

    }

    private void ResetPlayerType()
    {
        selectedPlayerType = null;
        selectedFileName = null;
        error = null;

        keepers.Clear();
        centrebacks.Clear();
        wingfullbacks.Clear();
        defmids.Clear();
        mids.Clear();
        wingers.Clear();
        strikers.Clear();

        KeeperState.Keepers.Clear();
        CBState.Centrebacks.Clear();
        WFBState.WingFullBacks.Clear();
        DMState.DefMids.Clear();
        MState.Mids.Clear();
        WState.Wingers.Clear();
        STState.Strikers.Clear();
    }
}

