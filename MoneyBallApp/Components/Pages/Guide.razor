@page "/Guide"

<PageTitle>How to Use | Money Ball APP</PageTitle>

<div class="guide-container">

    <header class="guide-header">
        <span class="guide-badge">GUIDE</span>
        <h1>Money Ball Valuation App</h1>
        <p>
            Follow the steps below to export your Football Manager 26
            player data and generate player valuations.
        </p>
    </header>

    <section class="guide-section">

        <h2>How to use</h2>

        <div class="steps">

            <div class="step">
                <div class="step-number">1</div>
                <div class="step-content">
                    <h3>Install R2Modman</h3>
                    <p>
                        Download and install R2Modman before continuing.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">2</div>
                <div class="step-content">
                    <h3>Download the player export plugin</h3>
                    <p>
                        Download the Football Manager 26 player export plugin
                        from
                        <a href="https://www.fmscout.com/a-fm26-player-csv-export.html"
                           target="_blank"
                           rel="noopener noreferrer">
                            FM Scout
                        </a>.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">3</div>
                <div class="step-content">
                    <h3>Create a Football Manager 26 profile</h3>
                    <p>
                        Open R2Modman and create a profile for Football Manager 26.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">4</div>
                <div class="step-content">
                    <h3>Install BepInEx</h3>
                    <p>
                        In R2Modman's <strong>Online</strong> section, install
                        <strong>BepInExPack_FootballManager26</strong>.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">5</div>
                <div class="step-content">
                    <h3>Open the Plugins folder</h3>
                    <p>
                        Navigate to:
                    </p>

                    <code>
                        DRIVE:\Users\USER\AppData\Roaming\r2modmanPlus-local\FootballManager26\profiles\PROFILE/BepInEx/Plugins
                    </code>
                </div>
            </div>

            <div class="step">
                <div class="step-number">6</div>
                <div class="step-content">
                    <h3>Add the player export plugin</h3>
                    <p>
                        Copy the downloaded player export plugin into the
                        <strong>Plugins</strong> folder.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">7</div>
                <div class="step-content">
                    <h3>Start Football Manager modded</h3>
                    <p>
                        Return to R2Modman and select
                        <strong>Start Modded</strong>.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">8</div>
                <div class="step-content">
                    <h3>Open your player database</h3>
                    <p>
                        Load your chosen save and navigate to the player database.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">9</div>
                <div class="step-content">
                    <h3>Import the player view</h3>
                    <p>
                        Import the chosen player type view into Football Manager.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">10</div>
                <div class="step-content">
                    <h3>Select your players</h3>
                    <p>
                        Select the group of players you want to value.
                        You can export up to <strong>5,000 players</strong> at once.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">11</div>
                <div class="step-content">
                    <h3>Export the players</h3>
                    <p>
                        Press <kbd>CTRL</kbd> + <kbd>P</kbd> to export the selected
                        players.
                    </p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">12</div>
                <div class="step-content">
                    <h3>Upload the exported file</h3>
                    <p>
                        Navigate to the <strong>Upload Players</strong> page
                        and upload the exported HTML file.
                    </p>

                    <div class="note">
                        <strong>Where is the file?</strong>
                        <p>
                            The export should be located in:
                        </p>

                        <code>
                            Documents/Sports Interactive/Football Manager 26/FM26PlayerExport by vinteset/Exports HTML
                        </code>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="result-section">
        <p>
            Once your players have been uploaded, Money Ball will process
            the data and provide player valuations.
        </p>

        <a href="/input" class="primary-button">
            Start Valuing Players
        </a>
    </section>

    <section class="help-section">
        <h2>Need help with the mod?</h2>
        <p>
            For more information about the player export mod, visit
            <a href="https://www.fmscout.com/a-fm26-player-csv-export.html"
               target="_blank"
               rel="noopener noreferrer">
                FM Scout
            </a>.
        </p>
    </section>

</div>