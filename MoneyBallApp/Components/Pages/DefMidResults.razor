                            </td>
                            <td>@defmid.Age</td>
                            <td>@defmid.Club</td>
                            <td>@defmid.Nation</td>

                            <td>@defmid.Interceptionsper90</td>
                            <td>@defmid.Blk90</td>
                            <td>@defmid.KeyTackles</td>
                            <td>@defmid.PassCompletionPercentage</td>
                            <td>@defmid.YellowCards</td>
                            <td>@defmid.RedCards</td>
                            <td>@defmid.TacklesCompletedper90</td>
