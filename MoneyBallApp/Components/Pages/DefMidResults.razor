                    <tr>
                        <th>Player</th>
                        <th>Actual</th>
                        <th>Predicted</th>
                        <th>Difference</th>
                        <th>Age</th>
                        <th>Current Club</th>
                        <th>Nationality</th>
                    </tr>
                </thead>

