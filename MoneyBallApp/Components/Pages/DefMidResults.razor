</div>
@code {
    private List<DefMid> defmids = new();
    private List<DefMid> topDefMids = new();
    private List<DefMid> allDefMids = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool allPlayers = false;
    private bool expanded = false;

    protected override void OnInitialized()
    {
        defmids = DMState.DefMids;
      
        if (defmids.Any())
        {
            try
            {
                DMPredictor.PredictDefMids(defmids);
                allDefMids = defmids.Where(dm => dm.PredictedValue.HasValue && dm.TransferValue.HasValue)
                .OrderByDescending(dm =>
                    (dm.PredictedValue!.Value - dm.TransferValue!.Value))
                .Take(100)
                .ToList();

                topDefMids = defmids
                .Where(dm => dm.PredictedValue.HasValue && dm.TransferValue.HasValue)
                .OrderByDescending(dm =>
                    (dm.PredictedValue!.Value - dm.TransferValue!.Value))
                .Take(25)
                .ToList();
                hasPredictions = topDefMids.Any();

            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            
        }
    }

    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
    }

    private void ToggleView()
    {
        expanded = !expanded;
    }
    
}
