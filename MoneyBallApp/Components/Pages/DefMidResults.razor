                        <tr>
                            <td>@defmid.PlayerName</td>
                            <td>£@defmid.TransferValue</td>
                            <td>
                                @(defmid.PredictedValue < 0
                                    ? "Model is not accurately able to predict this value"
                                    : $"£{defmid.PredictedValue}")
                            </td>
                            <td>
                                @(defmid.PredictedValue.Value - defmid.TransferValue.Value < 0
                                    ? "Player's Market value is higher than prediction"
                                    : $"£{defmid.PredictedValue.Value - defmid.TransferValue.Value}")
                            </td>
                            <td>@defmid.Age</td>
                            <td>@defmid.Club</td>
                            <td>@defmid.Nation</td>
