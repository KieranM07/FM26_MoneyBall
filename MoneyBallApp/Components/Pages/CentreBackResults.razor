@code {
    private List<CentreBack> centrebacks = new();
    private List<CentreBack> topCentreBacks = new();
    private List<CentreBack> allCentreBacks = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool allPlayers = false;
    private bool expanded = false;

    protected override void OnInitialized()
    {
        centrebacks = CBState.Centrebacks;
      
        if (centrebacks.Any())
        {
            try
            {
                CBPredictor.PredictCentreBacks(centrebacks);
                allCentreBacks = centrebacks.Where(cb => cb.PredictedValue.HasValue && cb.TransferValue.HasValue)
                .OrderByDescending(cb =>
                    (cb.PredictedValue!.Value - cb.TransferValue!.Value))
                .Take(100)
                .ToList();

                topCentreBacks = centrebacks
                .Where(cb => cb.PredictedValue.HasValue && cb.TransferValue.HasValue)
                .OrderByDescending(cb =>
                    (cb.PredictedValue!.Value - cb.TransferValue!.Value))
                .Take(25)
                .ToList();
                hasPredictions = topCentreBacks.Any();

            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            
        }
    }

    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
    }

    private void ToggleView()
    {
        expanded = !expanded;
    }
    
}
