@code {
    private List<Mid> mids = new();
    private List<Mid> topMids = new();
    private List<Mid> allMids = new();
    private bool hasPredictions = true;
    private string? error = null;
    private bool allPlayers = false;
    private bool expanded = false;

    protected override void OnInitialized()
    {
        mids = MState.Mids;
      
        if (mids.Any())
        {
            try
            {
                MPredictor.PredictMids(mids);
                allMids = mids.Where(m => m.PredictedValue.HasValue && m.TransferValue.HasValue)
                .OrderByDescending(m =>
                    (m.PredictedValue!.Value - m.TransferValue!.Value))
                .Take(100)
                .ToList();

                topMids = mids
                .Where(m => m.PredictedValue.HasValue && m.TransferValue.HasValue)
                .OrderByDescending(m =>
                    (m.PredictedValue!.Value - m.TransferValue!.Value))
                .Take(25)
                .ToList();
                hasPredictions = topMids.Any();

            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
            
        }
    }

    private void TogglePlayers()
    {
        allPlayers = !allPlayers;
    }

    private void ToggleView()
    {
        expanded = !expanded;
    }
    
}
