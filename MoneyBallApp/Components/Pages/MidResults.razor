@using MoneyBallApp.Components.States
@using MoneyBallApp.Models
@using MoneyBallApp.Services

@rendermode InteractiveServer

@inject MState MState
@inject MPredictorService MPredictor

<PageTitle>Predicted</PageTitle>

<h1>Money Ball Valuation App</h1>

